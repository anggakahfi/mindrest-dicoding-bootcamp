# Server
PORT=5000

# MongoDB Atlas (direct connection — bypass SRV lookup)
MONGODB_URI=mongodb://<username>:<password>@<cluster>.mongodb.net:27017/tweetmind?ssl=true&replicaSet=atlas-12wuvi-shard-0&authSource=admin&retryWrites=true&w=majority&appName=tweetmind-cluster

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# FastAPI AI Service URL
FASTAPI_URL=http://localhost:8000
